<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <extension
         point="org.eclipse.ui.commands">
      <category
            id="f1re.sysmlv2.lionweb.commands.lionweb"
            name="Lionweb Category">
      </category>
      <command
            categoryId="f1re.sysmlv2.lionweb.commands.lionweb"
            name="Ecore to LionCore"
            id="f1re.sysmlv2.lionweb.commands.ecoreToLionCore">
      </command>
      <command
            categoryId="f1re.sysmlv2.lionweb.commands.lionweb"
            id="f1re.sysmlv2.lionweb.commands.ecoreToJson"
            name="Ecore to JSON">
      </command>
   </extension>
   <extension
         point="org.eclipse.ui.handlers">
      <handler
            class="f1re.sysmlv2.lionweb.handlers.EcoreToLioncoreHandler"
            commandId="f1re.sysmlv2.lionweb.commands.ecoreToLionCore">
      </handler>
      <handler
            class="f1re.sysmlv2.lionweb.handlers.EcoreToJsonHandler"
            commandId="f1re.sysmlv2.lionweb.commands.ecoreToJson">
      </handler>
   </extension>
   <extension
         point="org.eclipse.ui.bindings">
      <key
            commandId="f1re.sysmlv2.lionweb.commands.ecoreToLionCore"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            contextId="org.eclipse.ui.contexts.window"
            sequence="M1+6">
      </key>
      <key
            commandId="f1re.sysmlv2.lionweb.commands.ecoreToJson"
            contextId="org.eclipse.ui.contexts.window"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="M1+7">
      </key>
   </extension>
   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="menu:org.eclipse.ui.main.menu?after=additions">
         <menu
               icon="icons/lionweb-logo.png"
               id="f1re.sysmlv2.lionweb.menus.lionwebMenu"
               label="Lionweb"
               mnemonic="LW"
               tooltip="Transform models into and from Lionweb format">
            <command
                  commandId="f1re.sysmlv2.lionweb.commands.ecoreToLionCore"
                  id="f1re.sysmlv2.lionweb.menus.ecoreToLionCore"
                  label="Ecore to LionCore"
                  mnemonic="S">
            </command>
            <command
                  commandId="f1re.sysmlv2.lionweb.commands.ecoreToJson"
                  id="f1re.sysmlv2.lionweb.menus.ecoreToJson"
                  label="Ecore to JSON"
                  mnemonic="J">
            </command>
         </menu>
      </menuContribution>
      <menuContribution
            locationURI="toolbar:org.eclipse.ui.main.toolbar?after=additions">
         <toolbar
               id="f1re.sysmlv2.lionweb.toolbars.lionwebToolbar">
            <command
                  id="f1re.sysmlv2.lionweb.toolbars.commands.ecoreToJson"
                  commandId="f1re.sysmlv2.lionweb.commands.ecoreToJson"
                  icon="icons/lionweb-logo.png"
                  tooltip="Export to LionWeb Json">
            </command>
         </toolbar>
      </menuContribution>
   </extension>

</plugin>
