// Transform a class and its super classes into the corresponding hierarchy of interfaces  
mapping inout EClass::Class2Interface() : EClass {
	// The output is the class that implements this interface
	result.name := self.name;
	result.eAnnotations := self.eAnnotations.deepclone();	// move or copy?
	result.interface := false;
	result.eSuperTypes := (self);
	self.ePackage.eClassifiers += result;

	// Transform the input class into the interface
	self.name := "I" + name; //+ "_LWInterface";
	self._abstract := true;
	self.interface := true;

	// Recursively invoke this mapping for the super types, that are not interfaces already
	self.eSuperTypes -> select(s | not s.interface) -> map Class2Interface();
	
	// Document with annotations for the reverse mappings
	self.eAnnotations += new EAnnotation("LionWeb-MultipleInheritance", "Changed this class into interface");	
	result.eAnnotations += new EAnnotation("LionWeb-MultipleInheritance", "Added this class to implement LW interface");
}

constructor EAnnotation :: EAnnotation(set_key : String, set_value : String) {
	source := "http://lionweb.io/metametamodel/2024.1";
	details += object EStringToStringMapEntry {
		key := set_key;
		value := set_value; 
	};
}
